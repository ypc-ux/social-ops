# --- Drafting (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Voice + budget gate (required for auto-approval; unset = everything holds for manual review) ---
ANTHROPIC_API_KEY=
VOICE_GATE_THRESHOLD=75

# --- X / Twitter API v2 (required for market_radar + reputation scanning + posting) ---
# Get these from https://developer.twitter.com — needs Elevated/Basic tier for search.
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Mastodon (free, keyless for reading) ---
# Reading public hashtag timelines needs NO key at all. Posting needs a free
# access token from your own account's Preferences > Development page.
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=

# --- LinkedIn ---
# LinkedIn's API does not offer general mention/keyword search or posting for
# most developer apps without Marketing Developer Platform partner approval.
# linkedin.py ships as a documented stub; drafts route to a CSV for manual
# posting until you have that access. See social_ops/platforms/linkedin.py.

# --- Approval notifications (optional but recommended) ---
# Incoming webhook URL from a Slack app — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# --- Database ---
SOCIAL_OPS_DB=social_ops.db
